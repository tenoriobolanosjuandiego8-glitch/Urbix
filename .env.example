# Django
DEBUG=False
DJANGO_SECRET_KEY=tu-clave-secreta-aqui-cámbiala-en-producción
ALLOWED_HOSTS=localhost,127.0.0.1,tudominio.com

# Base de datos
DATABASE_URL=sqlite:///db.sqlite3
# O PostgreSQL:
# DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/urbix
# O MariaDB:
# DJANGO_DB_ENGINE=mariadb

# Emails
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=tu-contraseña-app
EMAIL_USE_TLS=True

# APIs externas
OPENROUTESERVICE_API_KEY=tu-api-key-de-openrouteservice
GEOAPIFY_API_KEY=tu-api-key-de-geoapify
ANTHROPIC_API_KEY=tu-api-key-de-claude

# Web Push (notificaciones)
VAPID_PUBLIC_KEY=tu-clave-publica-vapid
VAPID_PRIVATE_KEY=tu-clave-privada-vapid

# Seguridad
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
